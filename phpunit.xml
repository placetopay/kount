<?xml version="1.0" encoding="UTF-8"?>
<phpunit backupGlobals="false" bootstrap="vendor/autoload.php" colors="true" processIsolation="false" stopOnFailure="false" cacheDirectory=".phpunit.cache" backupStaticProperties="false">
  <coverage>
    <report>
      <clover outputFile="./tests/coverage/coverage.xml"/>
      <html outputDirectory="./tests/coverage"/>
    </report>
  </coverage>
  <testsuites>
    <testsuite name="Feature">
      <directory suffix="Test.php">./tests</directory>
    </testsuite>
  </testsuites>
  <php>
    <env name="K_TEST_SERVICE" value="false"/>
    <env name="K_API_KEY" value=""/>
  </php>
  <logging>
    <junit outputFile="./tests/coverage/tests.xml"/>
  </logging>
  <source>
    <include>
      <directory suffix=".php">./app</directory>
    </include>
  </source>
</phpunit>
